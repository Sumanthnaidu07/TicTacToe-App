import java.util.Scanner;
import java.util.Random;

public class TicTacToe {

    // UC4: Convert slot to row & column
    public static int[] convertSlotToIndex(int slot) {
        int index = slot - 1;
        return new int[]{index / 3, index % 3};
    }

    // UC5: Validate move
    public static boolean isValidMove(char[][] board, int row, int col) {
        return (row >= 0 && row < 3 &&
                col >= 0 && col < 3 &&
                board[row][col] == ' ');
    }

    // UC6: Place move
    public static void placeMove(char[][] board, int row, int col, char symbol) {
        board[row][col] = symbol;
    }

    // UC7: Computer random move
    public static void computerMove(char[][] board, char symbol) {
        Random random = new Random();
        while (true) {
            int slot = random.nextInt(9) + 1;
            int[] pos = convertSlotToIndex(slot);
            if (isValidMove(board, pos[0], pos[1])) {
                placeMove(board, pos[0], pos[1], symbol);
                System.out.println("Computer chose slot: " + slot);
                break;
            }
        }
    }

    // Check win
    public static boolean checkWin(char[][] b, char s) {
        // rows & cols
        for (int i = 0; i < 3; i++) {
            if ((b[i][0] == s && b[i][1] == s && b[i][2] == s) ||
                (b[0][i] == s && b[1][i] == s && b[2][i] == s)) {
                return true;
            }
        }
        // diagonals
        return (b[0][0] == s && b[1][1] == s && b[2][2] == s) ||
               (b[0][2] == s && b[1][1] == s && b[2][0] == s);
    }

    // Check draw
    public static boolean isDraw(char[][] board) {
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                if (board[i][j] == ' ') return false;
            }
        }
        return true;
    }

    // Print board
    public static void printBoard(char[][] b) {
        System.out.println();
        for (int i = 0; i < 3; i++) {
            System.out.println(b[i][0] + " | " + b[i][1] + " | " + b[i][2]);
            if (i < 2) System.out.println("--+---+--");
        }
        System.out.println();
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        char[][] board = {
            {' ', ' ', ' '},
            {' ', ' ', ' '},
            {' ', ' ', ' '}
        };

        char currentPlayer = 'X'; // Human = X, Computer = O
        boolean gameRunning = true;

        printBoard(board);

        // UC8: Game loop
        while (gameRunning) {

            if (currentPlayer == 'X') {
                // Human turn
                System.out.print("Enter slot (1-9): ");
                int slot = sc.nextInt();

                int[] pos = convertSlotToIndex(slot);

                if (isValidMove(board, pos[0], pos[1])) {
                    placeMove(board, pos[0], pos[1], 'X');
                } else {
                    System.out.println("Invalid move, try again.");
                    continue; // retry same turn
                }

            } else {
                // Computer turn
                computerMove(board, 'O');
            }

            printBoard(board);

            // Check win
            if (checkWin(board, currentPlayer)) {
                System.out.println(currentPlayer + " wins! 🎉");
                gameRunning = false;
                break;
            }

            // Check draw
            if (isDraw(board)) {
                System.out.println("It's a draw!");
                gameRunning = false;
                break;
            }

            // Switch turn
            currentPlayer = (currentPlayer == 'X') ? 'O' : 'X';
        }

        sc.close();
    }
}
