import java.util.Random;

public class ComputerMove {

    // Convert slot (1–9) → row & column
    public static int[] convertSlotToIndex(int slot) {
        int index = slot - 1;
        int row = index / 3;
        int col = index % 3;
        return new int[]{row, col};
    }

    // Validate move
    public static boolean isValidMove(char[][] board, int row, int col) {
        return (row >= 0 && row < 3 &&
                col >= 0 && col < 3 &&
                board[row][col] == ' ');
    }

    // Place move
    public static void placeMove(char[][] board, int row, int col, char symbol) {
        board[row][col] = symbol;
    }

    // Computer random move (UC7)
    public static void computerMove(char[][] board, char symbol) {
        Random random = new Random();
        int slot;
        int row, col;

        while (true) {
            // Generate random slot (1–9)
            slot = random.nextInt(9) + 1;

            // Convert to row & column
            int[] position = convertSlotToIndex(slot);
            row = position[0];
            col = position[1];

            // Validate move
            if (isValidMove(board, row, col)) {
                placeMove(board, row, col, symbol);
                System.out.println("Computer chose slot: " + slot);
                break;
            }
        }
    }

    // Print board
    public static void printBoard(char[][] board) {
        System.out.println("Board:");
        for (int i = 0; i < 3; i++) {
            System.out.println(board[i][0] + " | " + board[i][1] + " | " + board[i][2]);
            if (i < 2) System.out.println("--+---+--");
        }
    }

    public static void main(String[] args) {

        // Initialize empty board
        char[][] board = {
            {' ', ' ', ' '},
            {' ', ' ', ' '},
            {' ', ' ', ' '}
        };

        printBoard(board);

        // Computer makes a move
        computerMove(board, 'O');

        printBoard(board);
    }
}
